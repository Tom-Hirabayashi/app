---
import Icon from '../Icon.astro';
import { getSiteConfig, type HomeDoingItem } from '../../data/site';
import { getUiText } from '../../utils/ui-text';

const { items } = Astro.props as { items: HomeDoingItem[] };
const ui = getUiText(await getSiteConfig());
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function resolveHref(href: string) {
  return /^(?:[a-z][a-z\d+.-]*:|#)/i.test(href)
    ? href
    : `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}
---

<article class="glass-card doing-card">
  <h2><Icon name="calendar" /> {ui.doing.recently}</h2>
  <ul>
    {
      items.map((item) => (
        <li>
          <span class="doing-copy">
            <span>{item.text}</span>
            {item.href && item.linkLabel && (
              <a href={resolveHref(item.href)}>
                <span aria-hidden="true">→</span> {item.linkLabel}
              </a>
            )}
          </span>
          <strong aria-hidden="true">{item.mark}</strong>
        </li>
      ))
    }
  </ul>
</article>

<style>
  .doing-card {
    padding: 24px 0 0;
    border-color: transparent;
    background: transparent;
    box-shadow: none;
  }

  .doing-card:hover {
    border-color: transparent;
    box-shadow: none;
    transform: none;
  }

  h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 16px;
    color: var(--paper-ink);
    font-size: 1.06rem;
  }

  h2 svg {
    width: 21px;
    height: 21px;
    color: var(--paper-accent);
  }

  ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 32px;
    gap: 12px;
    align-items: center;
    padding: 14px 0 14px 18px;
    border-top: 1px solid var(--paper-line);
    color: var(--paper-ink);
    font-size: 0.98rem;
  }

  li::before {
    position: absolute;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--paper-accent);
    content: '';
  }

  strong {
    font-size: 0.82rem;
    text-align: right;
  }

  .doing-copy a {
    display: inline;
    margin-left: 0.45em;
    color: var(--paper-accent);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .doing-copy a:hover {
    color: var(--paper-ink);
  }
</style>
