---
import { getSiteConfig, getTopNavLinks } from '../data/site';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';

const { profile, site } = await getSiteConfig();
const links = await getTopNavLinks();
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(href: string) {
  if (href === '/') {
    return `${basePath}/` || '/';
  }

  return `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
}
---

<header>
  <nav>
    <h2><a href={withBase('/')}>{site.title}</a></h2>
    <div class="internal-links">
      {links.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
    </div>
  </nav>
</header>
<style>
  header {
    margin: 0;
    padding: 0 1em;
    background: var(--paper-nav);
    border-bottom: 1px solid var(--paper-line);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
  }
  h2 {
    margin: 0;
    font-size: 1em;
  }

  h2 a,
  h2 a.active {
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  nav a {
    padding: 1em 0.5em;
    color: var(--paper-ink);
    border-bottom: 2px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--paper-accent);
  }
</style>
