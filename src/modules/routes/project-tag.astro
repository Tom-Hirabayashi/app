---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import BackLink from '../../components/blog/BackLink.astro';
import BlogTopNav from '../../components/blog/BlogTopNav.astro';
import { getSiteConfig } from '../../data/site';
import navfolioConfig from '../../../navfolio.config';
import { getPageModuleRoute } from '../../plugins/config';
import { slugifyGroupName } from '../../utils/content-groups';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ id, data }) => id !== 'index' && !data.draft);
  const tags = new Map<string, { name: string; projects: typeof projects }>();

  for (const project of projects) {
    for (const name of project.data.tags) {
      const slug = slugifyGroupName(name);
      const tag = tags.get(slug);

      if (tag) {
        tag.projects.push(project);
      } else {
        tags.set(slug, { name, projects: [project] });
      }
    }
  }

  return [...tags.entries()].map(([tag, value]) => ({
    params: { tag },
    props: value,
  }));
}

const { name, projects: unsortedProjects } = Astro.props;
const projects = [...unsortedProjects].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
);
const siteConfig = await getSiteConfig();
const { site, theme } = siteConfig;
const projectsRoute = getPageModuleRoute(navfolioConfig, 'projects');
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${basePath}${path}`;
---

<!doctype html>
<html lang={siteConfig.site.language} data-palette={theme.palette}>
  <head>
    <BaseHead title={`#${name} | ${site.title}`} description={`${name}のプロジェクト一覧`} />
  </head>
  <body>
    <BlogTopNav />
    <main data-pagefind-body>
      <BackLink href={`${projectsRoute}/`} label="Projectsに戻る" />
      <header class="tag-header">
        <p>PROJECT TAG</p>
        <h1>#{name}</h1>
        <span>{projects.length} 件のプロジェクト</span>
      </header>
      <section class="project-grid" aria-label={`#${name}のプロジェクト`}>
        {
          projects.map((project) => (
            <article class="project-card">
              <h2>
                <a href={withBase(`${projectsRoute}/${project.id}/`)}>{project.data.title}</a>
              </h2>
              <p>{project.data.description}</p>
              <footer>
                <FormattedDate date={project.data.date} />
                <span class="tags">
                  {project.data.tags.slice(0, 3).map((tag) => (
                    <a href={withBase(`${projectsRoute}/tags/${slugifyGroupName(tag)}/`)}>#{tag}</a>
                  ))}
                </span>
              </footer>
            </article>
          ))
        }
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    width: min(100%, var(--layout-shell-width));
    min-height: 70vh;
    padding: 118px var(--layout-page-gutter) var(--layout-page-bottom);
  }
  .tag-header {
    margin: 34px 0;
  }
  .tag-header p,
  .tag-header span,
  footer,
  .tags a {
    font-family: var(--font-ui-label);
  }
  .tag-header p {
    margin: 0 0 8px;
    color: var(--paper-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .tag-header h1 {
    margin: 0 0 10px;
    font-size: clamp(2rem, 5vw, 3.5rem);
  }
  .tag-header span {
    color: var(--paper-ink-soft);
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 22px);
  }
  .project-card {
    display: grid;
    gap: 14px;
    padding: 22px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-surface);
  }
  .project-card h2,
  .project-card p {
    margin: 0;
  }
  .project-card h2 {
    font-family: var(--font-ui-label);
    font-size: 1.3rem;
  }
  .project-card h2 a,
  .tags a {
    color: inherit;
    text-decoration: none;
  }
  .project-card h2 a:hover,
  .tags a:hover {
    color: var(--paper-accent);
  }
  .project-card p {
    color: var(--paper-ink-soft);
    line-height: 1.75;
  }
  .project-card footer {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    align-items: center;
    color: var(--paper-ink-faint);
    font-size: 0.76rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags a {
    padding: 3px 8px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
  }
  @media (max-width: 720px) {
    main {
      padding-top: 88px;
    }
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
